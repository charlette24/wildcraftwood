---
interface Props { title: string; description: string; youtubeId: string; date?: string; }
const { title, description, youtubeId, date } = Astro.props;
---
<article class="card video-card">
  <div class="video">
    <iframe src={`https://www.youtube-nocookie.com/embed/${youtubeId}`} title={title} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
  </div>
  <div class="card-body">
    {date && <p class="eyebrow">{new Date(`${date}T12:00:00`).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>}
    <h3>{title}</h3><p class="muted">{description}</p>
  </div>
</article>
<style>
.video { aspect-ratio: 16 / 9; background: #111; }
iframe { width: 100%; height: 100%; border: 0; }
</style>
