---
import { site } from '../data/site';
const links = [
  ['Work', '/#work'], ['Journal', '/journal'], ['Videos', '/videos'], ['Tools', '/tools'], ['About', '/about'], ['Contact', '/contact']
];
---
<header>
  <div class="container bar">
    <a class="brand" href="/" aria-label={`${site.name} home`}>
      <span class="mark">W</span><span>{site.name}</span>
    </a>
    <nav aria-label="Primary navigation">
      {links.map(([label, href]) => <a href={href}>{label}</a>)}
    </nav>
  </div>
</header>
<style>
header { position: sticky; top: 0; z-index: 20; background: rgba(243,239,230,.9); border-bottom: 1px solid var(--line); backdrop-filter: blur(16px); }
.bar { min-height: 72px; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
.brand { display: flex; align-items: center; gap: .65rem; text-decoration: none; font-weight: 900; letter-spacing: -.02em; }
.mark { width: 34px; height: 34px; display: grid; place-items: center; border-radius: 50%; background: var(--ink); color: var(--paper); font-family: Georgia, serif; }
nav { display: flex; gap: 1rem; flex-wrap: wrap; }
nav a { text-decoration: none; font-size: .9rem; font-weight: 750; }
@media (max-width: 780px) { nav { display: none; } }
</style>
